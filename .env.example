# =============================================================
# Ming Hwee WhatsApp Chatbot — environment configuration
# Copy to .env and fill in the blanks.
# =============================================================

# --- Supabase ---
SUPABASE_URL=https://qizcnyuzgylzoyfvymfo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for the LangGraph checkpointer.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the session pooler (port 5432) or direct connection. Leave blank to fall
# back to an in-memory checkpointer (state is lost on restart — dev only).
SUPABASE_DB_URL=

# --- Whapi (WhatsApp) ---
WHAPI_API_TOKEN=
WHAPI_BASE_URL=https://gate.whapi.cloud
# Shared secret for the Whapi webhook. Accepted either as a header
# (X-Whapi-Secret / X-Whapi-Signature / Authorization) or as the last path
# segment: POST /webhook/whapi/<secret>. Leave blank to disable verification
# (development only — refused in production).
WHAPI_WEBHOOK_SECRET=
# Thomas's WhatsApp Business number in E.164, e.g. +6591234567
WHAPI_SENDER_PHONE=

# --- OpenRouter (all LLM calls) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=moonshotai/kimi-k3
# Kimi K3 thinks before it answers, and that thinking is billed and timed.
# 'off' (default) = no thinking: ~3s replies, same quality, far cheaper.
# 'low' / 'medium' / 'high' = let it think. 'default' = the model decides.
LLM_REASONING=off

OPENROUTER_SITE_URL=https://minghwee.com
OPENROUTER_APP_NAME=Ming Hwee Chatbot

# --- Embeddings (query embedding for RAG) ---
# MUST match the RAG pipeline that built cb_knowledge_base, or every similarity
# score comes back low and the bot hands over on every message.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Leave EMBEDDING_BASE_URL blank to call OpenAI directly with OPENAI_API_KEY.
# Set it to https://openrouter.ai/api/v1 (and EMBEDDING_API_KEY to the
# OpenRouter key) to embed through OpenRouter, matching the pipeline.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OPENAI_API_KEY=

# --- Voice transcription ---
# Voice notes are transcribed before they reach the bot, so it answers what the
# client said instead of "[voice]". Goes through OpenRouter, so no extra key is
# needed — TRANSCRIPTION_API_KEY falls back to OPENROUTER_API_KEY.
# With this off (or no key), a voice note is treated as an attachment: the bot
# acknowledges it, raises a media ticket and hands over.
#
# NOTE: OpenRouter's audio endpoint takes base64 JSON, not the multipart upload
# OpenAI and Groq use. Changing TRANSCRIPTION_BASE_URL to another host also
# needs a code change in app/services/transcription.py.
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_BASE_URL=https://openrouter.ai/api/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Who gets assault escalations and partner enquiries. Blank = the oldest active
# 'admin' profile. Set this when several admins exist and it matters which one
# is paged.
ESCALATION_PROFILE_ID=

# --- Application ---
# Ming Hwee's tenant UUID from the tenants table
TENANT_ID=
ENVIRONMENT=development
LOG_LEVEL=INFO

# Seconds to wait after the last inbound message before processing
DEBOUNCE_SECONDS=3

# RAG retrieval tuning — calibrate with scripts/check_retrieval.py
RAG_MATCH_THRESHOLD=0.25
RAG_MATCH_COUNT=5
# If the best match scores below this, the bot hands over instead of guessing
RAG_CONFIDENCE_FLOOR=0.30
# Cap on each chunk injected into the prompt (20% overlap = longer chunks)
RAG_MAX_CHUNK_CHARS=1200
# Restrict search to one namespace, e.g. document_chunks. Blank = search all.
RAG_NAMESPACE=

# How many past messages are replayed into the LLM prompt
HISTORY_LIMIT=20

# --- Safety gate ---
# Restrict the bot to these numbers. EMPTY MEANS EVERY CLIENT — set it to your
# own number while testing so the bot cannot reply inside a live client thread.
BOT_ALLOWED_NUMBERS=

# Never take over a conversation a human agent replied to in the last N hours.
AGENT_GRACE_HOURS=24

# How long a conversation stays with a human before the bot may pick it up
# again. It also returns immediately when an agent marks the thread resolved in
# the portal. 0 = handovers are permanent.
HUMAN_ACTIVE_TIMEOUT_HOURS=72
