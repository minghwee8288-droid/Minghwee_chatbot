# =============================================================
# Ming Hwee — Clear Conversation UI
# Local: copy to .env.local and fill in. Vercel: set these as
# Environment Variables on the project (Production + Preview).
#
# NONE of these is prefixed NEXT_PUBLIC_, so none of them is
# bundled into the browser. The service-role key in particular
# must never be exposed — it bypasses RLS on a database shared
# with two other products.
# =============================================================

# --- Required ---

# Same project the chatbot uses.
SUPABASE_URL=https://qizcnyuzgylzoyfvymfo.supabase.co

# Supabase dashboard -> Project Settings -> API -> service_role.
# NOT the anon key: the anon key is constrained by RLS and cannot
# delete these rows, which is the whole job here.
SUPABASE_SERVICE_ROLE_KEY=

# Must match TENANT_ID in the chatbot's .env, or no lead is ever found.
TENANT_ID=

# --- Optional: the password ---

# The page has a built-in password (Minghwee@123, in reset-ui/lib/env.ts), so
# it works with this left blank. Set it here to override that without a code
# change -- which also keeps the real password out of git, and is what you
# want the day this is used on live client numbers.
RESET_UI_PASSWORD=

# --- Strongly recommended ---

# Direct Postgres connection, used ONLY to clear the LangGraph
# checkpoint tables (cb_checkpoints / cb_checkpoint_blobs /
# cb_checkpoint_writes). Those are created outside PostgREST's
# schema cache and cannot be reached through the Supabase REST API.
#
# Supabase dashboard -> Project Settings -> Database -> Connection
# string -> URI. Use a POOLER url (Transaction mode, port 6543) —
# a serverless function opens a new connection per request and the
# direct connection will exhaust the connection limit.
#
# Leave blank and everything else still works; the bot's saved
# memory for the thread is simply left behind, and the UI says so.
SUPABASE_DB_URL=

# --- Optional safety gate ---

# Comma-separated. When set, ONLY these numbers can be looked up or
# cleared — the same fail-closed idiom as the chatbot's
# BOT_ALLOWED_NUMBERS. Leave EMPTY to allow any number.
#
# Set this while testing. Clear it when the client needs the tool on
# real numbers.
RESET_ALLOWED_NUMBERS=
