# kb-admin configuration. Copy to .env.local (git-ignored) and fill in.
# Every value is read server-side only: nothing here is NEXT_PUBLIC_.
# kb-admin refuses to start if these do not all name the same project.

# The Supabase project ref this instance is allowed to read.
KB_ADMIN_EXPECTED_REF=

# Supabase Auth (sign-in only). The ANON key - kb-admin refuses a
# service-role or secret key.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# The read-only database login. Pooler host, transaction mode (6543).
KB_ADMIN_DB_HOST=
KB_ADMIN_DB_PORT=6543
KB_ADMIN_DB_USER=kb_admin_reader.<ref>
# The password, one of two ways. If KB_ADMIN_DB_PASSWORD is set it is used;
# otherwise the password is read from the file KB_ADMIN_DB_PASSWORD_FILE names.
# Locally, prefer the file (it keeps the password out of every env file).
KB_ADMIN_DB_PASSWORD_FILE=
# On Vercel there is no file: set this in the project's Environment Variables
# (never NEXT_PUBLIC_, never committed). Leave it empty here.
KB_ADMIN_DB_PASSWORD=

# "Test a question": the bot's POST /admin/preview. http is accepted for
# localhost only. Leave the secret empty to switch the page off.
BOT_PREVIEW_URL=http://127.0.0.1:8000
ADMIN_PREVIEW_SECRET=
