# kb-admin configuration. Copy to .env.local (git-ignored) and fill in.
# Every value is read server-side only: nothing here is NEXT_PUBLIC_.
# kb-admin refuses to start if these do not all name the same project.

# The Supabase project ref this instance is allowed to read.
KB_ADMIN_EXPECTED_REF=

# Supabase Auth (sign-in only). The ANON key - kb-admin refuses a
# service-role or secret key.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# The read-only database login. Pooler host, transaction mode (6543).
KB_ADMIN_DB_HOST=
KB_ADMIN_DB_PORT=6543
KB_ADMIN_DB_USER=kb_admin_reader.<ref>
# The password, one of two ways. If KB_ADMIN_DB_PASSWORD is set it is used;
# otherwise the password is read from the file KB_ADMIN_DB_PASSWORD_FILE names.
# Locally, prefer the file (it keeps the password out of every env file).
KB_ADMIN_DB_PASSWORD_FILE=
# On Vercel there is no file: set this in the project's Environment Variables
# (never NEXT_PUBLIC_, never committed). Leave it empty here.
KB_ADMIN_DB_PASSWORD=

# "Test a question": the bot's POST /admin/preview. http is accepted for
# localhost only. Leave the secret empty to switch the page off.
BOT_PREVIEW_URL=http://127.0.0.1:8000
ADMIN_PREVIEW_SECRET=

# --- The Q&A editor (Phase 2) -------------------------------------------------
# Leave ALL of these empty and kb-admin stays read-only: no edit control is
# shown and nothing can write. Set some but not all and it stays read-only
# too (the start-up log says what is missing).
#
# The editor's database login is always kb_admin_editor.<KB_ADMIN_EXPECTED_REF>
# on the same pooler host; only its password is set here. One of two ways,
# exactly like the reader's: the value (Vercel), or a file (locally).
KB_ADMIN_DB_PASSWORD_EDITOR=
KB_ADMIN_DB_PASSWORD_EDITOR_FILE=
# The key kb-admin uses to embed an entry's new text. It must reach the SAME
# endpoint and model as the bot: the model is read from cb_kb_canary, and
# kb-admin refuses to publish until its vector for the canary sentence
# matches the bot's. The bot's production .env embeds through OpenRouter
# (EMBEDDING_BASE_URL=https://openrouter.ai/api/v1), so set the base URL
# below to the same and use an OpenRouter key (sk-or-...). Empty base URL =
# https://api.openai.com/v1 with an OpenAI key.
KB_ADMIN_EMBEDDING_API_KEY=
KB_ADMIN_EMBEDDING_BASE_URL=

# --- KB watcher (migration 015; all OFF by default) -----------------------------
# Watched pages, fetch-now, drafting and the review queue. Needs the editor
# settings above AND migration 015 applied. Exactly "true" to switch on.
KB_SOURCES_ENABLED=
# OpenRouter key (sk-or-...) for drafting. Empty = the embedding key above, if
# that is an OpenRouter key. Model defaults to the bot's (openai/gpt-5.6-luna).
KB_ADMIN_LLM_API_KEY=
KB_ADMIN_DRAFT_MODEL=
# The schedule (Vercel cron, vercel.json, daily; each page re-checked every
# WATCHER_INTERVAL_DAYS, default 7). Needs KB_SOURCES_ENABLED=true too.
WATCHER_ENABLED=
WATCHER_INTERVAL_DAYS=
# Vercel sends this on its cron call (Authorization: Bearer ...); 32+ characters.
CRON_SECRET=
# An ACTIVE editor/approver user id (cb_kb_admin_users) whose access the
# scheduled run uses for the read-only live search. Snapshots and drafts are
# recorded as "watcher (scheduled)", never as this person.
KB_WATCHER_ACTOR_ID=

# --- Local testing against the TEST project ------------------------------------
# Put the TEST project's values in .env.test.local (git-ignored; same keys as
# above) and run `npm run dev:test`: port 5177, build folder .next-test.
# .env.local is never read for anything the test file leaves out, and the
# launcher refuses a test file that names the production project.
