# Copy to .env on the server. The same value goes into kb-admin's KB_RENDER_SECRET on Vercel.
# Generate one with:  openssl rand -hex 32
RENDER_SECRET=
# Which sites may be rendered: a comma list of hosts (each also allows its
# subdomains). Default: the Indonesian embassy only. "*" = any public https host.
# RENDER_ALLOWED_HOSTS=kemlu.go.id
# The browser. The image sets "chrome" (system Chrome); empty = Playwright's bundled Chromium.
# RENDER_CHROME_CHANNEL=chrome
# Optional (defaults shown). The gap may not be lower than 10000.
# RENDER_MIN_GAP_MS=10000
# RENDER_TIMEOUT_MS=30000
